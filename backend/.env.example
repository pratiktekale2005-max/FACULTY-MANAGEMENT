# =================================================================
# FACULTY ACTIVITY MANAGEMENT - BACKEND CONFIGURATION EXAMPLE
# =================================================================
# Rename or copy this file to .env in the backend folder and fill in your values.

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/crm

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server Port
PORT=5000

# Nodemailer Credentials for OTP & Notification Dispatch
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
