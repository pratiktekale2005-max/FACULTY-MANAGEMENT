# =================================================================
# FACULTY CRM - BACKEND CONFIGURATION EXAMPLE
# =================================================================
# Rename or copy this file to .env in the backend folder and configure your real secrets.

# Database Connection (MongoDB Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ux2ilnq.mongodb.net/crm

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# Nodemailer SMTP Credentials for Notifications, Tasks & Official Letters
# Note: For Gmail, enable 2-Step Verification and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_institution_email@gmail.com
EMAIL_PASS=your_16_character_app_password


